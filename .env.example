# Supabase Storage — staging for verification uploads (bypasses Vercel's 4.5MB body limit)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Enables direct upload (prod). On-prem: leave unset (files go via multipart)
NEXT_PUBLIC_USE_DIRECT_UPLOAD=

# Passkeys (WebAuthn)
WEBAUTHN_SECRET=

# Optional: pin the OCI MySQL CA (PEM) after a rotation
MYSQL_CA=

# Optional: max request body size accepted by Next.js routes and Server Actions
# Increase if verification uploads exceed the default (e.g. 300mb)
MAX_UPLOAD_BODY_SIZE=200mb

# MinIO — public base URL and bucket for creative thumbnails on /sentimentos
# (silver_social_comments.creative_image_path is an object key, not a URL)
# Optional: code falls back to the current ngrok tunnel + bucket if unset
MINIO_PUBLIC_BASE_URL=https://purveyor-undead-oops.ngrok-free.dev
MINIO_BUCKET=social-ad-creatives
